<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".fragments.PantryList">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="72dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/removeFloatingButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            app:fabCustomSize="40dp"
            app:maxImageSize="18dp"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            app:hoveredFocusedTranslationZ="0dp"
            app:backgroundTint="#D32F2F"
            app:tint="@android:color/white"
            app:srcCompat="@android:drawable/ic_menu_delete"
            android:contentDescription="Remove ingredient" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/editFloatingButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            app:fabCustomSize="40dp"
            app:maxImageSize="18dp"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            app:hoveredFocusedTranslationZ="0dp"
            app:backgroundTint="#757575"
            app:tint="@android:color/white"
            app:srcCompat="@android:drawable/ic_menu_edit"
            android:contentDescription="Edit ingredient" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addFloatingButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:fabCustomSize="44dp"
            app:maxImageSize="20dp"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            app:hoveredFocusedTranslationZ="0dp"
            app:tint="@android:color/white"
            app:srcCompat="@android:drawable/ic_input_add"
            android:contentDescription="Add ingredient" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>